# OpportunityOS Environment Configuration

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./opportunity_os.db
# For PostgreSQL: postgresql+asyncpg://opportunity:opportunity_secret_password@localhost:5434/opportunity_os
REDIS_URL=redis://localhost:6380/0
TEMPORAL_HOST=localhost:7233

# Automation Level (0: Discovery, 1: Recommend, 2: Prepare, 3: Approval Gate, 4: High Confidence Auto, 5: Full Auto)
AUTOMATION_LEVEL=3

# AI provider for drafts and form-answer suggestions (optional: without a key, plain templates are used
# and unanswered form questions pause for you). OpenAI is used when OPENAI_API_KEY is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Alternatively Claude; set LLM_PROVIDER=anthropic to prefer it when both keys are set
ANTHROPIC_API_KEY=
LLM_PROVIDER=

# Security
SECRET_KEY=opportunity_os_super_secret_dev_key_2026
NEXT_PUBLIC_API_URL=http://localhost:8000
