{
  "name": "opportunity-os",
  "version": "1.0.0",
  "description": "AI-Powered Opportunity Discovery, Application Automation & Networking Platform",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "PYTHONPATH=. .venv/bin/uvicorn apps.api.main:app --host 127.0.0.1 --port 8000 --reload",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "test": ".venv/bin/pytest tests/ -v"
  },
  "keywords": [
    "ai",
    "career",
    "automation",
    "job-search",
    "nextjs",
    "fastapi"
  ],
  "author": "",
  "license": "MIT"
}
